# ===== قاعدة البيانات =====
# للحصول المحلي: file:./db/custom.db
# للإنتاج (Firebase Cloud PostgreSQL / Turso / Supabase):
DATABASE_URL=file:./db/custom.db

# ===== JWT =====
JWT_SECRET=change-this-to-a-very-long-random-secret-key

# ===== NODE ENV =====
NODE_ENV=production

# ===== Python AI Service (اختياري) =====
AI_SERVICE_URL=http://localhost:3001
