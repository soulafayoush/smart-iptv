# ===== قاعدة البيانات (PostgreSQL للإنتاج) =====
# أنشئ قاعدة بيانات مجانية على Supabase أو Neon
# واستبدل هذا الرابط برابط قاعدة بياناتك
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# ===== JWT =====
# غيّر هذا إلى مفتاح سري طويل وعشوائي
JWT_SECRET=your-super-secret-jwt-key-change-this

# ===== NODE ENV =====
NODE_ENV=production

# ===== Python AI Service =====
# ضع رابط خدمة الذكاء الاصطناعي هنا
# إذا رفعتها على Render: https://your-ai-service.onrender.com
AI_SERVICE_URL=http://localhost:3001
